{
  "name": "internguide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:a6:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --runInBand src/contexts/AuthContext.test.tsx",
    "test:a6:vitest": "vitest run src/tests/job-tracker.service.test.ts src/tests/Resume.test.tsx",
    "test:a6": "npm run test:a6:jest && npm run test:a6:vitest",
    "build:a6": "npm run build && npm run test:a6",
    "test:all": "npm run build:a6 --if-present && cd backend && npm run build:a6 --if-present"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.32.0",
    "mermaid": "^10.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "jsdom": "^26.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.8"
  }
}
